{
  "id": "workbuddy-cn",
  "name": "WorkBuddy CN",
  "version": "1.0.0",
  "entry": "index.mjs",
  "capabilities": ["discover", "checkin", "keepalive"],
  "needs": ["http.outbound", "log.write", "credentials.resolve"],
  "actions": [
    {
      "op": "accounts.discover",
      "effects": {
        "accessesNetwork": false,
        "mutatesTarget": false,
        "idempotent": true
      }
    },
    {
      "op": "checkin.run",
      "effects": {
        "accessesNetwork": true,
        "mutatesTarget": true,
        "idempotent": true
      }
    },
    {
      "op": "keepalive.run",
      "effects": {
        "accessesNetwork": true,
        "mutatesTarget": true,
        "idempotent": false
      }
    }
  ],
  "dayRule": { "tz": "Asia/Shanghai" },
  "compatibility": { "qka": ">=1.0.0" }
}
