# macOS
.DS_Store

# 本地工作区（工单跟踪器、研究笔记、原型、探针，均为本地临时产物）
.scratch/
.video_agent/
**/.qka/

# 第三方参考资料（可重新下载的 magpie 源码与压缩包）
001参考资料/

# Go
/qka
*.exe
*.test
*.out
# 通用依赖目录；前端离线 3D 运行时是产品资源，必须入库。
vendor/
!internal/gui/frontend/assets/vendor/

# 构建产物
build/
!build/
!build/windows/
!build/windows/winres.json
!build/windows/icon-*.png
dist/
# 历史 dist 快照由 scripts/build-dmg.sh 之外的手工备份产生，不应进入版本库
dist.backup-*/
out/

# 本地环境与密钥
.env
.env.local
*.pem
*.key
