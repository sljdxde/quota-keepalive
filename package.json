{
  "name": "quota-keepalive",
  "version": "0.1.13",
  "description": "Unofficial multi-provider quota inventory, check-in, keepalive scheduling, history, and quota trends for Magpie",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "quota",
    "checkin",
    "keepalive"
  ],
  "author": "sljdxde",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sljdxde/quota-keepalive.git"
  },
  "homepage": "https://github.com/sljdxde/quota-keepalive#readme",
  "bugs": {
    "url": "https://github.com/sljdxde/quota-keepalive/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "bin": {
    "daily-keepalive-log": "bin/daily-keepalive-log.js"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "Quota Keepalive",
      "titles": {
        "zh": "额度签到",
        "zh-TW": "額度簽到",
        "ja": "クォータ・キープアライブ",
        "de": "Kontingent & Keepalive"
      },
      "file": "ui/index.html",
      "icon": "ui/icon.svg"
    },
    "permissions": [
      "providers:list",
      "usage:summary"
    ]
  },
  "files": [
    "index.js",
    "src",
    "bin",
    "ui",
    "README.md",
    "LICENSE",
    "!ui/data.js",
    "!ui/data.json"
  ],
  "scripts": {
    "test": "bun test",
    "logs": "node ./bin/daily-keepalive-log.js",
    "prepublishOnly": "bun test"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
